<%- include('../partials/header') %>

<style>
    body {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        min-height: 100vh;
    }

    .register-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .register-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    }

    .register-header {
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: white;
        text-align: center;
        padding: 30px 20px;
    }

    .register-header h3 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .register-header p {
        margin-bottom: 0;
        opacity: 0.9;
        font-size: 14px;
    }

    .register-body {
        background: white;
        padding: 35px;
    }

    .form-label {
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .form-control {
        height: 52px;
        border-radius: 12px;
        border: 1px solid #dbeafe;
        padding-left: 15px;
        transition: all .3s ease;
    }

    .form-control:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 0.2rem rgba(220,38,38,.15);
    }

    .btn-register {
        height: 52px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: white;
        font-weight: 700;
        transition: .3s;
    }

    .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(220,38,38,.25);
    }

    .info-box {
        margin-top: 20px;
        padding: 12px;
        background: #f8fafc;
        border-left: 4px solid #dc2626;
        border-radius: 8px;
        font-size: 13px;
        color: #64748b;
    }

    .login-link a {
        color: #0f4c81;
        font-weight: 700;
    }

    .login-link a:hover {
        text-decoration: underline !important;
    }
</style>

<div class="register-wrapper">
    <div class="col-md-7 col-lg-6">
        <div class="card register-card">

```
        <div class="register-header">
            <h3>SIPMAS</h3>
            <p>Sistem Informasi Pengaduan Masyarakat</p>
        </div>

        <div class="register-body">

            <form action="/auth/register" method="POST">

                <div class="mb-3">
                    <label class="form-label">
                        Username
                    </label>
                    <input
                        type="text"
                        name="username"
                        class="form-control"
                        required
                        placeholder="Buat Username">
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Nomor Induk Kependudukan (NIK)
                    </label>
                    <input
                        type="text"
                        name="nik"
                        class="form-control"
                        required
                        maxlength="16"
                        placeholder="Masukkan 16 Digit NIK">
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Nomor Handphone (WhatsApp)
                    </label>
                    <input
                        type="text"
                        name="no_telp"
                        class="form-control"
                        required
                        placeholder="Contoh: 08123456789">
                </div>

                <div class="mb-4">
                    <label class="form-label">
                        Password
                    </label>
                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        required
                        minlength="6"
                        placeholder="Minimal 6 karakter">
                </div>

                <button type="submit" class="btn btn-register w-100">
                    DAFTAR SEKARANG
                </button>

            </form>

            <div class="info-box">
                🔒 Data NIK dan nomor telepon digunakan untuk verifikasi identitas pelapor dan dijaga kerahasiaannya.
            </div>

            <div class="text-center mt-4 login-link">
                <p class="mb-1 text-muted">
                    Sudah memiliki akun?
                </p>
                <a href="/auth/login" class="text-decoration-none">
                    Login di sini
                </a>
            </div>

        </div>

    </div>
</div>
```

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
