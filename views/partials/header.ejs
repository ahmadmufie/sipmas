<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIPMAS - Sistem Informasi Pengaduan Masyarakat</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

    <style>

        :root{
            --police-blue:#0A2342;
            --police-light:#1E3A5F;
            --emergency-red:#D90429;
            --bg-light:#f1f5f9;
        }

        body{
            background:var(--bg-light);
            font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
        }

        .bg-police{
            background:linear-gradient(
                135deg,
                var(--police-blue),
                var(--police-light)
            ) !important;
        }

        .btn-police{
            background:var(--police-blue);
            color:white;
            border:none;
        }

        .btn-police:hover{
            background:#061528;
            color:white;
        }

        .btn-emergency{
            background:var(--emergency-red);
            color:white;
            border:none;
        }

        .btn-emergency:hover{
            background:#a3031f;
            color:white;
        }

        /* HEADER */

        .navbar{
            min-height:75px;
            box-shadow:0 4px 20px rgba(0,0,0,.15);
        }

        .navbar-brand{
            display:flex;
            align-items:center;
            gap:12px;
            font-weight:700;
        }

        .logo-circle{
            width:42px;
            height:42px;
            border-radius:50%;
            background:rgba(255,255,255,.15);
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:20px;
        }

        .brand-text{
            line-height:1.1;
        }

        .brand-title{
            font-size:18px;
            font-weight:700;
            color:white;
        }

        .brand-subtitle{
            font-size:11px;
            color:rgba(255,255,255,.75);
        }

        .user-panel{
            display:flex;
            align-items:center;
            gap:15px;
        }

        .user-badge{
            background:rgba(255,255,255,.12);
            padding:8px 15px;
            border-radius:30px;
            color:white;
            font-size:14px;
        }

        .btn-login{
            border-radius:10px;
            padding:8px 18px;
        }

        .btn-register{
            border-radius:10px;
            padding:8px 18px;
            font-weight:600;
        }

        .btn-logout{
            border-radius:10px;
            padding:8px 18px;
        }

        @media(max-width:768px){

            .brand-subtitle{
                display:none;
            }

            .user-badge{
                display:none;
            }

        }

    </style>

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-police">

    <div class="container-fluid px-4">

        <a class="navbar-brand" href="/">

            <div class="logo-circle">
                🚨
            </div>

            <div class="brand-text">

                <div class="brand-title">
                    SIPMAS
                </div>

                <div class="brand-subtitle">
                    Sistem Informasi Pengaduan Masyarakat
                </div>

            </div>

        </a>

        <div class="user-panel">

            <% if(locals.user) { %>

                <div class="user-badge">
                    👤 Halo,
                    <strong><%= user.nama %></strong>
                </div>

                <a href="/auth/logout"
                   class="btn btn-outline-light btn-sm btn-logout">
                    Logout
                </a>

            <% } else { %>

                <a href="/auth/login"
                   class="btn btn-outline-light btn-sm btn-login">
                    Login
                </a>

                <a href="/auth/register"
                   class="btn btn-light btn-sm btn-register">
                    Daftar
                </a>

            <% } %>

        </div>

    </div>

</nav>