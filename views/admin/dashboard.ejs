<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

// Inisialisasi Peta Admin
const adminMap = L.map('admin-map').setView(
    [-6.914744, 107.609810],
    12
);

L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    {
        attribution:'© OpenStreetMap contributors'
    }
).addTo(adminMap);


// Ambil data laporan
fetch('/reports/gis-data')

.then(res => res.json())

.then(data => {

    // Statistik
    document.getElementById('total-count').textContent =
        data.length;

    document.getElementById('waiting-count').textContent =
        data.filter(
            r => r.status === 'Menunggu'
        ).length;

    document.getElementById('process-count').textContent =
        data.filter(
            r => r.status === 'Diproses'
        ).length;

    document.getElementById('done-count').textContent =
        data.filter(
            r => r.status === 'Selesai'
        ).length;


    // Marker
    data.forEach(report => {

        let color = '#D90429';

        if(report.status === 'Diproses')
            color = '#FFC107';

        if(report.status === 'Selesai')
            color = '#198754';

        const customIcon = L.divIcon({

            className:'custom-marker',

            html:`
                <div
                    style="
                        background:${color};
                        width:24px;
                        height:24px;
                        border-radius:50%;
                        border:3px solid white;
                        box-shadow:0 0 6px rgba(0,0,0,.4);
                    ">
                </div>
            `,

            iconSize:[24,24],
            iconAnchor:[12,12]

        });

        const marker = L.marker(
            [
                report.latitude,
                report.longitude
            ],
            {
                icon:customIcon
            }
        ).addTo(adminMap);

        marker.bindPopup(`

            <div class="custom-popup" style="min-width:220px;">

                <h6 class="fw-bold border-bottom pb-2">
                    ${report.kategori}
                </h6>

                <div class="small mb-2">

                    <strong>Pelapor:</strong>
                    ${report.nama_lengkap}

                    <br>

                    <strong>Status:</strong>
                    ${report.status}

                    <br>

                    <strong>Waktu:</strong>

                    ${new Date(
                        report.created_at
                    ).toLocaleString('id-ID')}

                </div>

                <p class="small border rounded p-2 bg-light">

                    ${report.deskripsi}

                </p>

                ${
                    report.foto
                    ?
                    `
                    <img
                        src="/uploads/${report.foto}"
                        style="
                            width:100%;
                            height:120px;
                            object-fit:cover;
                            margin-bottom:10px;
                        "
                    >
                    `
                    :
                    ''
                }

                <button
                    class="btn btn-detail btn-sm w-100">

                    Detail & Tindakan

                </button>

            </div>

        `);

    });

})

.catch(err => {

    console.error(
        'Gagal memuat data GIS:',
        err
    );

});
</script>

</body>
</html>
